{
  "name": "listening-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "next build",
    "build:web": "pnpm --dir apps/web build",
    "start": "next start",
    "lint": "eslint",
    "lint:web": "pnpm --dir apps/web lint",
    "test": "node -r ./tests/register-alias.cjs --import tsx --experimental-test-module-mocks --test --test-concurrency=1 --test-isolation=none tests/index.test.ts",
    "test:watch": "node -r ./tests/register-alias.cjs --import tsx --experimental-test-module-mocks --test --test-concurrency=1 --test-isolation=none --watch tests/index.test.ts",
    "import:audio": "tsx scripts/import-audio.ts",
    "db:prisma:format": "pnpm --dir packages/db prisma:format",
    "db:prisma:validate": "pnpm --dir packages/db prisma:validate",
    "db:prisma:generate": "pnpm --dir packages/db prisma:generate",
    "db:push": "pnpm --dir packages/db prisma:db:push"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "mssql": "^12.5.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
