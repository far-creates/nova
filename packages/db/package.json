{
  "name": "@nova/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database package for the Nova platform",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "prisma:format": "prisma format --schema prisma/schema.prisma",
